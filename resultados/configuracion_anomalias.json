  "modelos": {
    "Mahalanobis": {
      "assume_centered": false,
      "block_size": 1000,
      "store_precision": true
    },
    "PCA": {
      "copy": true,
      "iterated_power": "auto",
      "n_components": 10,
      "n_oversamples": 10,
      "power_iteration_normalizer": "auto",
      "random_state": null,
      "svd_solver": "full",
      "tol": 0.0,
      "whiten": false
    },
    "Isolation Forest": {
      "bootstrap": false,
      "contamination": "auto",
